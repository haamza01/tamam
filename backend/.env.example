APP_NAME=Tamam
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tamam
DB_USERNAME=tamam
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=tamam-public
PUBLIC_ASSETS_URL=http://localhost:9000/tamam-public
AWS_URL=http://localhost:9000/tamam-public
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
PUBLIC_ASSETS_DRIVER=s3
STORAGE_PROVISION_BUCKETS=false
AVATAR_DISK=public_assets
AVATAR_DEFAULT_URL=/images/default-avatar.svg
LISTING_IMAGE_DISK=public_assets
LISTING_IMAGE_SOURCE_DISK=local
LISTING_IMAGE_MAX_KB=10240
LISTING_IMAGE_MAX_COUNT=20
LISTING_IMAGE_MAX_WIDTH=1920
LISTING_IMAGE_THUMBNAIL_WIDTH=400
LISTING_IMAGE_WEBP_QUALITY=82
LISTING_IMAGE_MAX_PIXELS=40000000
LISTING_IMAGE_MAX_DIMENSION=8000

VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

OTP_DRIVER=log
