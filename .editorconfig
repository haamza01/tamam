root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,json,yml,yaml,css,scss,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[compose.yaml]
indent_size = 2

[docker-compose.yml]
indent_size = 2

[Makefile]
indent_size = 4

[*.php]
indent_size = 4

[*.blade.php]
indent_size = 4

[*.sh]
end_of_line = lf

[*.ps1]
end_of_line = crlf
